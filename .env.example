# ============================================
# MatchIQ Backend — Environment Variables
# Copy to .env and fill in values
# ============================================

# ── Server ──
PORT=3001
NODE_ENV=production

# ── Admin ──
ADMIN_PASSWORD=change-me-on-first-deploy

# ── PostgreSQL ──
DATABASE_URL=postgresql://matchiq:matchiq@localhost:5432/matchiq

# ── JWT ──
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_REFRESH_EXPIRES_IN=30d

# ── DeepSeek AI ──
DEEPSEEK_API_KEY=

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── CS2 Match API ──
CS_API_URL=https://api.cstest.pp.ua

# ── Google Sheets (read-only, for legacy data import) ──
GOOGLE_SHEETS_API_KEY=

# ── Redis (optional — rate limiting + JWT blocklist) ──
REDIS_URL=

# ── Browserless (optional — headless browser as Docker service) ──
# When set, scraper connects to browserless/chrome instead of launching in-process.
# Local: BROWSERLESS_URL=ws://localhost:3003
BROWSERLESS_URL=

# ── tips.gg scraping proxies (optional — rotate on Cloudflare ban) ──
# Comma-separated HTTP/HTTPS/SOCKS proxy URLs. When set, the scraper routes
# tips.gg requests through them and rotates to the next proxy on 403/429.
#   TIPSGG_PROXIES="http://user:pass@host:port,http://user2:pass2@host2:port2"
TIPSGG_PROXIES=
